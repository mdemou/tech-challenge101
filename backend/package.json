{
  "name": "f1simulatorapi-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch -r dotenv/config -r tsconfig-paths/register src/main.ts",
    "build": "rm -rf dist && tsc && tsc-alias && node -e \"require('fs').cpSync('src/data','dist/data',{recursive:true})\"",
    "start": "node -r dotenv/config dist/main.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hapi/boom": "^10.0.0",
    "@hapi/hapi": "^21.3.0",
    "@hapi/inert": "^7.1.0",
    "@hapi/vision": "^7.0.3",
    "dotenv": "^16.0.0",
    "hapi-swagger": "^17.3.2",
    "joi": "17.13.3",
    "pino": "9.4.0",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.11.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "nodemon": "^3.0.0",
    "tsc-alias": "^1.8.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0"
  }
}
