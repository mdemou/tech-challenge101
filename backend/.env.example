# Backend env — loaded by the API process (dotenv) and the e2e test runner.
# This API serves hardcoded JSON from src/data; there is no database to configure.

PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
BACKEND_URL=http://localhost:3001

# Rate limiting (applies to any route that opts in via createRateLimitPre)
RATE_LIMIT_DEFAULT_MAX=100
RATE_LIMIT_DEFAULT_WINDOW_MS=3600000
